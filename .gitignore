.venv/
__pycache__/
*.pyc
.DS_Store
.pytest_cache/
*.egg-info/
*.local.toml

# Runs: one directory per run, never repo content.
.artifacts/
# Operator trees made by hand (`forge init <op> --kernel-file ...`); a run keeps its own.
/operators/
# This machine: GPU, ssh host, credentials. Never committed.
local.env
uv.lock
# A probe describes one machine; a committed one would be read as if it described every
# machine. target/B200.json is the target profile and *is* committed.
target/dev.json
target/B200.rendered.md
# `forge lib fetch` clones external kernel libraries here; the index records what they are,
# never the trees themselves.
kernel_library/_sources/
# A calibration describes one machine and one day (`forge calibrate`); it is not code.
calibration/
# Upload archives made by `forge campaign pack`.
dist/
# Security-scanner state (local only).
.mimosa/
# Board-task scaffolding is made per machine (`forge init --leaderboard` / campaign `plan`).
tasks/sol-*
