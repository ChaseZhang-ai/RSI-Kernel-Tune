# Copy to local.env (gitignored): the machine a run uses. Never part of a task.
# The environment wins over this file for any key both set.

# Where the GPU is: this machine (local) or one host reachable over ssh (ssh).
FK_DELIVERY=local
# The CUDA device to run on; forgekernel's runs on one GPU take turns (a per-GPU lock).
FK_GPU=0

# ssh only: a host alias that logs in without a prompt, a directory on it used only by
# forgekernel (each run replaces trees under it), and optionally a script sourced first.
REMOTE_HOST=
REMOTE_WORKDIR=
REMOTE_ENV_FILE=

# Credentials for the agents (Claude Code) with provider = "native": one of these, or the
# CLI's own login. A provider of global_config/backends.toml reads its key from the variable
# its key_env names; set that variable here.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# -- the graded hardware (docs/target-hardware.md) ------------------------------------------
# Kernels are graded on a B200; this machine may be a B300. `forge target probe` measures it
# into target/dev.json (gitignored), `forge target check` lists what differs.
#
# Kernel code may honour this to size its grid for the *graded* GPU's SM count (148 on a
# B200). It does not exist on the board: code must fall back to querying the device.
# FK_TARGET_SMS=148
#
# The architecture the card compiles for. A task's [task] dev_arch sets it; setting it here
# overrides every card on this machine (e.g. when the same tree is run on another GPU).
# FK_CUDA_ARCH=sm_103a
