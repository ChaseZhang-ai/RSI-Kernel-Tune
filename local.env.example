# Copy to local.env (gitignored): the machine a run uses. Never part of a task.
# The environment wins over this file for any key both set.

# Where the GPU is: this machine (local) or one host reachable over ssh (ssh).
FK_DELIVERY=local
# The CUDA device to run on; forgekernel's runs on one GPU take turns (a per-GPU lock).
FK_GPU=0

# local only, optional: a command that holds a GPU lock shared with other work on this machine
# in front of every job. Its value is split like a shell would and ends with `--`; the job's
# entry command is put after that:
#     FK_JOB_LOCK_CMD=/path/to/with-lock gpu 1800 --
# A job that never got the lock is reported as "could not be delivered" and is never charged to
# the kernel; the wait for the lock is not taken out of the job's time limit. ssh delivery
# ignores it (the host takes its own lock there).
FK_JOB_LOCK_CMD=

# ssh only: a host alias that logs in without a prompt, a directory on it used only by
# forgekernel (each run replaces trees under it), and optionally a script sourced first.
REMOTE_HOST=
REMOTE_WORKDIR=
REMOTE_ENV_FILE=

# Credentials for the agents with provider = "native": one of these, or the CLI's own login.
# A provider of global_config/backends.toml reads its key from the variable its key_env names;
# set that variable here. Claude Code:
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Codex (backend = "codex", teacher only: docs/agent-backends.md), when codex is installed and
# logged out: OPENAI_API_KEY (or CODEX_API_KEY), or `codex login` for its own login state.
OPENAI_API_KEY=
CODEX_API_KEY=

# -- agent turns (docs/agent-backends.md) ---------------------------------------------------
# A downgraded turn (the model refused the context and the CLI moved the whole session to a
# fallback model) is ended instead of retried: the same context is refused again, and what
# the fallback model produces cannot be attributed to the model the run is about.
# FK_AGENT_ON_FALLBACK=fail     (default) | warn
#
# Replace --dangerously-skip-permissions with --permission-mode <value> (default,
# acceptEdits, plan, ...). A non-bypass mode waits for a human at the prompt: interactive
# debugging only.
# FK_AGENT_PERMISSION_MODE=plan
#
# The ledger a run writes (teacher, student and judge turns in one file) is
# <run dir>/agent_usage.jsonl. Set here only to point the launcher scripts elsewhere.
# FK_AGENT_USAGE_FILE=

# -- the graded hardware (docs/target-hardware.md) ------------------------------------------
# Kernels are graded on a B200; this machine may be a B300. `forge target probe` measures it
# into target/dev.json (gitignored), `forge target check` lists what differs.
#
# Kernel code may honour this to size its grid for the *graded* GPU's SM count (148 on a
# B200). It does not exist on the board: code must fall back to querying the device.
# FK_TARGET_SMS=148
#
# The architecture the card compiles for. A task's [task] dev_arch sets it; setting it here
# overrides every card on this machine (e.g. when the same tree is run on another GPU).
# FK_CUDA_ARCH=sm_103a
