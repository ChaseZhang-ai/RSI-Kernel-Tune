# Example upstream loop configuration for a leaderboard task.
#
# Copy this over the `loop.toml` that `forge init ... --leaderboard sol-execbench`
# generates for a task, then edit [target] with the latency target produced by
#   python -m vulcan plan --json-out plan.json
# (plan.json -> kernels.<name>.target_ms_geomean, or per workload).
#
# Upstream reads tasks/<op>/task.toml for the problem and takes the rest from
# global_config/.  See vendor/ForgeKernel/docs/leaderboards.md for the authoritative
# description; this file only records VULCAN's recommended settings.

[target]
# SOL-ExecBench: target = T_b / ratio, so ratio 1.0 stops at S = 0.5.
# Prefer an absolute ms taken from the VULCAN plan (it targets a *score*, not a ratio).
ms = 0.018483            # placeholder: 009_gemm_n5120_k2048 at ~S=0.56
timing = "device"

[agent]
model = "claude-opus-5-5"
effort = "high"

[budget]
hours = 8                # wall-clock for recon + distillation + student rounds
max_meta = 2             # teacher rounds that may revise the milestone (M0 is frozen)

[reference]
# For a leaderboard task the reference comes with the card; do not override it here.
# SOL tasks do not time the eager PyTorch reference (it is host-bound noise); they rank
# against the board's published T_b, frozen into problem.json at `forge init` time.

# VULCAN-specific guidance (not read by upstream):
# - Run >= 4 architecturally distinct M0 hypotheses per kernel, 1h -> 3h -> 7h
#   successive halving, before committing the full budget to the survivor.
# - Reject any candidate whose accumulation precision is below the operator contract,
#   even if its elementwise error passes (see vulcan.precision_guard).
# - Promote a new reference only when the paired-ratio CI clears the noise floor
#   (see vulcan.stats.accept_gain).
